<div class="panel"><h3>Talepler</h3><div class="table-responsive"><table class="table"><thead><tr><th>No</th><th>Yayıncı</th><th>Tür</th><th>Puan</th><th>Durum</th><th>Tarih</th><th>Durum değiştir</th></tr></thead><tbody>{foreach $ntcr_requests as $r}<tr><td>{$r.request_no|escape:'html':'UTF-8'}</td><td>@{$r.handle|escape:'html':'UTF-8'}</td><td>{$r.type|escape:'html':'UTF-8'}</td><td>{$r.points|number_format:0:',':'.'}</td><td>{$r.status|escape:'html':'UTF-8'}</td><td>{$r.date_add|escape:'html':'UTF-8'}</td><td><form method="post"><input type="hidden" name="id_request" value="{$r.id_request|intval}"><select name="to_status"><option>approved</option><option>preparing</option><option>shipped</option><option>delivered</option><option>scheduled</option><option>processing</option><option>completed</option><option>review</option><option>failed</option><option>payment_pending</option><option>paid</option><option>rejected</option><option>cancelled</option></select><input name="public_note" placeholder="Yayıncı açıklaması"><input name="private_note" placeholder="Dahili not"><button class="btn btn-primary btn-xs" name="transitionNtcrRequest">Uygula</button></form></td></tr>{foreachelse}<tr><td colspan="7">Talep yok.</td></tr>{/foreach}</tbody></table></div></div>
