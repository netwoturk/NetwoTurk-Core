<div class="panel"><h3>Yayıncı eşleştirmeleri</h3><div class="table-responsive"><table class="table"><thead><tr><th>Müşteri</th><th>Doğrulanmış</th><th>Bekleyen</th><th>Creator ID</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>{foreach $ntcr_publishers as $p}<tr><td>{$p.firstname|escape:'html':'UTF-8'} {$p.lastname|escape:'html':'UTF-8'}<br><small>{$p.email|escape:'html':'UTF-8'}</small></td><td>@{$p.handle|escape:'html':'UTF-8'}</td><td>@{$p.pending_handle|escape:'html':'UTF-8'}</td><td>{$p.creator_id|escape:'html':'UTF-8'}</td><td>{$p.status|escape:'html':'UTF-8'}</td><td>{if $p.pending_handle}<form method="post"><input type="hidden" name="id_publisher" value="{$p.id_publisher|intval}"><input name="creator_id" placeholder="Creator ID (isteğe bağlı)"><button class="btn btn-primary" name="verifyPublisher">Doğrula</button></form>{/if}</td></tr>{foreachelse}<tr><td colspan="6">Kayıt yok.</td></tr>{/foreach}</tbody></table></div></div>
