<div class="panel"><h3>Ödül / keşfet paketi ekle</h3><form method="post"><div class="row"><div class="col-md-3"><label>Tür</label><select name="type" class="form-control"><option value="gift">Hediye</option><option value="explore">Keşfet desteği</option></select></div><div class="col-md-3"><label>Ad</label><input class="form-control" name="name" required></div><div class="col-md-2"><label>Puan</label><input class="form-control" type="number" min="1" name="points" required></div><div class="col-md-2"><label>Stok (boş=sınırsız)</label><input class="form-control" type="number" min="0" name="stock"></div></div><label>Açıklama</label><textarea class="form-control" name="description"></textarea><label>Hizmet kapsamı</label><textarea class="form-control" name="service_scope"></textarea><div class="row"><div class="col-md-3"><label>Minimum ön bildirim (saat)</label><input class="form-control" type="number" min="0" name="min_notice_hours" value="24"></div><div class="col-md-3"><label>Slot kapasitesi</label><input class="form-control" type="number" min="1" name="slot_capacity" value="1"></div></div><br><button class="btn btn-primary" name="saveNtcrCatalog">Kaydet</button></form></div><div class="panel"><h3>Katalog</h3><table class="table"><thead><tr><th>Tür</th><th>Ad</th><th>Puan</th><th>Stok</th><th>Durum</th><th></th></tr></thead><tbody>{foreach $ntcr_catalog as $c}<tr><td>{$c.type|escape:'html':'UTF-8'}</td><td>{$c.name|escape:'html':'UTF-8'}</td><td>{$c.points|number_format:0:',':'.'}</td><td>{$c.stock|escape:'html':'UTF-8'}</td><td>{if $c.active}Aktif{else}Pasif{/if}</td><td><form method="post"><input type="hidden" name="id_catalog" value="{$c.id_catalog|intval}"><button class="btn btn-default" name="toggleNtcrCatalog">Aktif/Pasif</button></form></td></tr>{foreachelse}<tr><td colspan="6">Katalog boş.</td></tr>{/foreach}</tbody></table></div>
